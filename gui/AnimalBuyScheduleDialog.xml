            <!-- ANYTHING THAT WOULD OTHERWISE BE SILENT: a client, a stand down, a
                 refusal, or why nothing sold. Full width and on the LEFT, because in
                 SELL RULES the sentence is long and the right column is full. -->
            <Bitmap profile="ARList" position="40px -706px" size="1120px 48px" imageColor="0 0 0 0">
                <Text profile="ARBarLabel" position="12px 0px" size="1096px 48px" textSize="12px"
                      textMaxNumLines="2" id="noteText"/>
            </Bitmap>
