                <Text profile="ARNumberHint" id="numHint5" />
                <Button profile="fs25_multiTextOptionLeft"  id="numLeft5"  onClick="onNum5Left" />
                <Button profile="fs25_multiTextOptionRight" id="numRight5" onClick="onNum5Right" />
            </Bitmap>

            <!-- THE ON / OFF SWITCH for slot 5. Declared for every slot even though
