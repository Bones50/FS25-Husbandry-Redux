                 moves. Clear of slot 6, which ends at -574. -->
            <Bitmap profile="ARList" position="820px -586px" size="340px 30px" imageColor="0 0 0 0">
                <Text profile="ARBarLabel"      position="12px 0px"  size="190px 30px" textSize="13px" id="lblRuns"/>
