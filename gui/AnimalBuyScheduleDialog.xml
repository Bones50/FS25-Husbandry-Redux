            <Bitmap profile="fs25_multiTextOptionContainer" position="820px -412px" size="340px 38px"
                    imageColor="0 0 0 0" id="togBox4" visible="false">
                <BinaryOption profile="ARToggle" id="tog4" onClick="onTog4" />
            </Bitmap>

            <Bitmap profile="ARList" position="820px -454px" size="340px 20px" imageColor="0 0 0 0" id="lblBox5">
                <Text profile="ARBarLabel" position="12px 0px" size="328px 20px" textSize="12px" id="lbl5" />
            </Bitmap>
            <Bitmap profile="fs25_multiTextOptionContainer" position="820px -474px" size="340px 38px"
                    imageColor="0 0 0 0" id="optBox5">
                <MultiTextOption profile="fs25_settingsMultiTextOption" id="opt5" wrap="true"
                                 onClick="onOpt5" textColor="0.9 0.9 0.9 1" textColorHighlight="1 1 1 1"/>
            </Bitmap>

            <Bitmap profile="fs25_multiTextOptionContainer" position="820px -474px" size="340px 38px"
                    imageColor="0 0 0 0" id="numBox5" visible="false">
                <ThreePartBitmap profile="fs25_multiTextOptionBg" />
                <TextInput profile="ARNumberInput" id="numInput5"
                           onEnterPressed="onNum5Enter" onEscPressed="onNum5Esc"
