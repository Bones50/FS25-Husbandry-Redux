            <Bitmap profile="fs25_multiTextOptionContainer" position="820px -474px" size="340px 38px"
                    imageColor="0 0 0 0" id="togBox5" visible="false">
                <BinaryOption profile="ARToggle" id="tog5" onClick="onTog5" />
            </Bitmap>

            <Bitmap profile="ARList" position="820px -516px" size="340px 20px" imageColor="0 0 0 0" id="lblBox6">
                <Text profile="ARBarLabel" position="12px 0px" size="328px 20px" textSize="12px" id="lbl6" />
            </Bitmap>
            <Bitmap profile="fs25_multiTextOptionContainer" position="820px -536px" size="340px 38px"
                    imageColor="0 0 0 0" id="optBox6">
                <MultiTextOption profile="fs25_settingsMultiTextOption" id="opt6" wrap="true"
                                 onClick="onOpt6" textColor="0.9 0.9 0.9 1" textColorHighlight="1 1 1 1"/>
            </Bitmap>

            <Bitmap profile="fs25_multiTextOptionContainer" position="820px -536px" size="340px 38px"
                    imageColor="0 0 0 0" id="numBox6" visible="false">
                <ThreePartBitmap profile="fs25_multiTextOptionBg" />
                <TextInput profile="ARNumberInput" id="numInput6"
                           onEnterPressed="onNum6Enter" onEscPressed="onNum6Esc"
