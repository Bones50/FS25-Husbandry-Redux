<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!-- Husbandry Redux: this mod's own GUI profiles.

     AR HAS NEVER HAD ONE UNTIL NOW. Every profile its layouts name is either the
     base game's or one of DR's (SDList, SDRowCell, SDHeaderLeft, SDBarLabel,
     SDInputsDialogBox), which is a dependency worth being aware of but is not
     what this file is for. It exists for the TEXT PICKER, whose two pieces have
     no stock equivalent.

     BOTH ARE ANCHORED, NOT POSITIONED. DR 5.70 records a text input and its label
     ignoring an absolute x/y outright, because a stock profile places itself; and
     DR 5.87a records that "with" is read on PROFILES ONLY and is silently ignored
     on an element. So the anchoring lives here, where it is actually read.

     THE 80px INSET IS THE TWO ARROWS. fs25_multiTextOptionLeft and Right are 40px
     each and anchor to the ends of their container, so 40 off each side leaves the
     middle to the field. It is DELIBERATELY WIDER THAN THE STOCK TEXT PROFILE'S
     50px total: a text input CONSUMES a mouse click where a text label does not,
     so any overlap with an arrow would be a dead arrow.

     COMMENT RULE: no double hyphen inside an XML comment. It is a parse error and
     FS25 answers it by not loading the layout at all; DR records it costing six
     builds. tools/check_xml.py catches it before a deploy. -->
<GUIProfiles>

    <!-- THE FIELD. Transparent by inheritance: fs25_textInput sets imageSliceId
         noSlice and every image colour to zero, so the multiTextOption background
         behind it shows through and the control looks exactly like the selector it
         replaces. maxInputTextWidth is cut to the 260px this actually occupies
         (340 box less the two 40px arrows), from the 229 the stock profile sizes
         for its own 249px box. -->
    <Profile name="ARNumberInput" extends="fs25_textInput" with="anchorStretchingYStretchingX">
        <size value="100% 100%" />
        <absoluteSizeOffset value="80px 0px" />

        <textSize value="16px" />
        <textAlignment value="center" />
        <textColor value="0.9 0.9 0.9 1" />
        <maxInputTextWidth value="240px" />
    </Profile>

    <!-- THE GREY PROMPT that sits over the field while it is empty. A SEPARATE
         ELEMENT because TextInputElement has no placeholder at all (imePlaceholder
         reaches the console IME overlay and never the field), and because a prompt
         held in the field's own text becomes real input the moment a character is
         appended to it.

         It cannot steal the click: TextElement declares no mouseEvent of its own
         and GuiElement:mouseEvent only propagates. Read in the shipped source,
         not assumed, because a prompt that ate the click would make the field
         unfocusable and read as a dead control.

         SMALLER AND DIMMER THAN THE VALUE, so a prompt is never mistaken for a
         number that has been chosen. The value is 16px at 0.9 grey. -->
    <Profile name="ARNumberHint" extends="fs25_textDefault" with="anchorStretchingYStretchingX">
        <size value="100% 100%" />
        <absoluteSizeOffset value="80px 0px" />

        <textSize value="14px" />
        <textAlignment value="center" />
        <textColor value="0.5 0.5 0.5 1" />
        <textMaxNumLines value="1" />
    </Profile>


    <!-- THE BASE GAME'S OWN ON / OFF SWITCH, the one the Game Settings screen uses
         for Traffic and Snow. Requested 2026-09-02 in place of a two entry
         selector ring: a ring makes a yes/no answer look like a list you step
         through, and both states are visible at once on a real switch.

         BinaryOptionElement EXTENDS MultiTextOptionElement, so it answers setTexts,
         setState, getState and raises onClick exactly the same way. That is what
         makes this a swap of the element rather than of the handler.

         EVERY PART OF IT IS PERCENTAGE SIZED (the two halves are 50% 100%, the
         background and slider stretch), so it scales to whatever box it is put in.
         Stretched to fill the 340px slot so it lines up with the typed fields
         above and below it rather than sitting narrower in the middle. -->
    <Profile name="ARToggle" extends="fs25_binaryOption" with="anchorStretchingYStretchingX">
        <size value="100% 100%" />
    </Profile>


    <!-- AN IN-ROW ARROW. DR 5.64 proved a Button can live inside a SmoothList row
         and be clicked: SmoothListElement:mouseEvent calls its SUPERCLASS FIRST and
         gates its own row selection on "not eventUsed", so a child that consumes a
         click fires AND the row does not also select.

         THE ANCHOR IS THE ONLY OVERRIDE, per that entry's hard-won rule: resize the
         stock arrow and it samples the UI atlas wrongly and renders as garbled
         blocks. fs25_multiTextOptionRight anchors to its PARENT's right edge, which
         in a row is the far end of the row rather than the end of its cell, so it is
         re-anchored LEFT and then placed by position like everything else. The left
         arrow needs no profile at all: the stock one is already left anchored.

         AR's OWN rather than DR's SDRowArrowRight, which is identical: this mod
         already leans on DR for a dozen profiles and there is no reason to add a
         thirteenth for one line. -->
    <Profile name="ARRowArrowRight" extends="fs25_multiTextOptionRight" with="anchorStretchingYLeft" />

    <!-- A TEXT BUTTON INSIDE A TABLE ROW (2026-09-13): Buy and Sell on the Pigs
         tab's animals, Auto Trader on its breeds. Built on the base game's
         fs25_wideButton, which AR's dialog buttons already render through.

         THREE OVERRIDES, each read from ButtonElement.lua (27% blank, complete):
         * iconSize and iconTextOffset ZERO. fs25_wideButton reserves a 30px key
           glyph at a -10px offset, and when centring the button shifts its text
           right by (iconWidth - iconTextOffset) / 2 = 20px (getIconModifiedTextOffset).
           That is what pushed every label to the right edge of its box. With no
           glyph there is no shift, so centred text is centred.
         * textAutoWidth ON, fitToContent OFF. updateSize then sets the WIDTH to
           icon + text + fitExtraWidth and keeps the height, so the box is exactly
           as wide as its label plus padding. fitToContent would also force the
           height down to the text height.
         * THE BOX IS THE BUTTON'S OWN BACKGROUND. baseReference's solid slice
           gui.colorPreset, tinted, which emptyPanel switches off. Drawn by the
           button itself, so it resizes with the text and needs no separate
           rectangle in the layout. Hover and focus lighten it. -->
    <Profile name="ARRowButton" extends="fs25_wideButton" with="anchorBottomLeft">
        <textSize value="12px"/>
        <fitToContent value="false"/>
        <textAutoWidth value="true"/>
        <fitExtraWidth value="12px"/>
        <iconSize value="0px 0px"/>
        <iconTextOffset value="0px 0px"/>
        <imageSliceId value="gui.colorPreset"/>
        <imageColor value="0.24 0.26 0.29 0.9"/>
        <imageHighlightedColor value="0.34 0.37 0.41 1"/>
        <imageFocusedColor value="0.34 0.37 0.41 1"/>
        <imageSelectedColor value="0.24 0.26 0.29 0.9"/>
        <imageDisabledColor value="0.24 0.26 0.29 0.4"/>
    </Profile>

    <!-- ======================================================================
         THE ELEVEN PROFILES THIS MOD USED TO BORROW FROM DISTRIBUTION REDUX.

         Ported 2026-09-07, for the standalone plan. AR's layouts named SDList,
         SDRowCell, SDHeaderLeft, SDBarLabel, SDInputsDialogBox and six more across
         223 instances - every table, list and dialog in the mod - and every one
         of them was defined in DR's DistributionSiloProfiles.xml.

         THAT DEPENDENCY FAILED SILENTLY, WHICH IS WHY IT HAD TO GO FIRST. A layout
         naming a profile nobody loaded does NOT error: it falls back to a default
         with no positioning at all (27.5, DR 5.64). So without DR installed, every
         AR table would have rendered scattered across the screen with nothing in
         the log to say why - the hardest kind of bug to be handed by a player.

         COPIED AND RENAMED, NOT SHARED. Keeping DR's names would have been less
         work today and would put two mods in one profile registry: whoever loaded
         first would win, and the day DR changed SDRowCell's height AR would ship a
         stale copy of it with no error either way. These are AR's now.

         NONE OF THEM NEEDS A PRESET OF DR'S - checked, not assumed: they
         reference only base-game presets (colorDisabled, fs25_colorMainHighlight
         and so on), so the port carries no further dependency.

         The inheritance chain was rewired with them: ARHeaderRight extends
         ARHeaderLeft, ARRowCellR extends ARRowCell, ARBarLabelRight extends
         ARBarLabel, ARListItemStats extends ARListItem, ARInputsDialogBox extends
         ARAdvDialogBox. The bases still extend the base game's baseReference /
         emptyPanel / fs25_dialogBg, which are always present.

         KEPT BYTE-FOR-BYTE OTHERWISE. Anything that looks odd here (SDRowCellR
         being left-aligned, the 42px row pitch living in the PROFILE rather than
         the instance size) is deliberate on DR's side and documented there -          DR 5.22 and 5.55. Do not "tidy" them; they are load-bearing geometry.
         ====================================================================== -->

<Profile name="ARHeaderLeft" extends="baseReference">
        <imageColor value="0 0 0 0" />
        <textFocusedColor value="$preset_fs25_colorMainHighlight" />
        <textHighlightedColor value="$preset_fs25_colorMainHighlight" />
        <textSize value="16px" />
        <textBold value="true" />
        <textUpperCase value="true" />
        <textColor value="$preset_colorWhite_50" />
        <textAlignment value="left" />
        <textDisabledColor value="$preset_colorDisabled" />
    </Profile>

<Profile name="ARHeaderRight" extends="ARHeaderLeft">
        <textAlignment value="left" />
    </Profile>

<!-- The A / D hints at each end of a tab strip. TEXT GLYPHS, not the stock arrow art:
     the icon there is sampled from the UI atlas and garbles whenever it is re-sized
     (DR 5.64), and these need a letter beside them. A chevron in text cannot garble.
     BUTTONS as well as hints, so a mouse player can click them.
     AR'S OWN, never borrowed from DR: this mod runs standalone, and check_profiles.py
     enforces that every profile a layout names is AR's or the base game's. -->
<Profile name="ARTabArrow" extends="emptyPanel">
    <size value="40px 40px" />
    <textBold value="true" />
    <textSize value="18px" />
    <textAlignment value="center" />
    <textVerticalAlignment value="middle" />
    <textColor value="$preset_fs25_colorMainLight" />
    <textFocusedColor value="$preset_fs25_colorMainHighlight" />
    <textSelectedColor value="$preset_fs25_colorMainHighlight" />
</Profile>

<Profile name="ARList" extends="emptyPanel" with="anchorStretchingYLeft pivotTopLeft">
    </Profile>

<Profile name="ARListItem" extends="baseReference" with="anchorTopStretchingX alternating">
        <height value="56px"/>
        <imageColor value="$preset_fs25_colorGrey" />
        <imageSelectedColor value="$preset_fs25_colorMainHighlight" />
        <alternateBackgroundColor value="$preset_fs25_colorGreyDark_50" />
    </Profile>

<Profile name="ARListItemStats" extends="ARListItem">
        <height value="42px"/>
    </Profile>

<Profile name="ARRowCell" extends="baseReference" with="anchorStretchingYLeft">
        <textBold value="false" />
        <textSize value="18px" />
        <textAlignment value="left" />
        <textColor value="$preset_fs25_colorMainLight" />
        <textSelectedColor value="$preset_fs25_colorMainDark" />
        <textDisabledColor value="$preset_colorDisabled" />
    </Profile>

<Profile name="ARRowCellR" extends="ARRowCell">
        <textAlignment value="left" />
    </Profile>

<Profile name="ARBarLabel" extends="baseReference">
        <textBold value="false" />
        <textSize value="11px" />
        <textAlignment value="left" />
        <textVerticalAlignment value="middle" />
        <textColor value="$preset_fs25_colorMainLight" />
        <textSelectedColor value="$preset_fs25_colorMainDark" />
    </Profile>

<Profile name="ARBarLabelRight" extends="ARBarLabel">
        <textAlignment value="right" />
    </Profile>

<Profile name="ARAdvDialogBox" extends="fs25_dialogBg">
        <size value="1400px 780px" />
    </Profile>

<Profile name="ARInputsDialogBox" extends="ARAdvDialogBox">
        <size value="1400px 900px" />
    </Profile>

    <!-- The GUIDE's two profiles, ported alongside the other eleven when AR grew its own Help page.
         A body ROW draws no background of its own (all three image colours transparent) so a long
         passage reads as prose rather than as a striped table, and the CELL is 16px non-bold, which
         is what the base game uses for body copy in fs25_dialogText. DR 5.x records the 18px it
         carried before that being the only reason its guide read larger than every other text panel
         in the game. -->
    <Profile name="ARBodyItem" extends="baseReference" with="anchorTopStretchingX">
        <height value="27px"/>
        <imageColor value="0 0 0 0" />
        <imageSelectedColor value="0 0 0 0" />
        <imageFocusedColor value="0 0 0 0" />
    </Profile>

    <Profile name="ARBodyCell" extends="baseReference" with="anchorStretchingYLeft">
        <textBold value="false" />
        <textSize value="16px" />
        <textAlignment value="left" />
        <textVerticalAlignment value="middle" />
        <textColor value="$preset_fs25_colorMainLight" />
        <textSelectedColor value="$preset_fs25_colorMainLight" />
        <textFocusedColor value="$preset_fs25_colorMainLight" />
    </Profile>

</GUIProfiles>
