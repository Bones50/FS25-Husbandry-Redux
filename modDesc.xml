<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!-- descVersion 111, matching Distribution Redux. This mod uses only launch-era
     schema, so a lower value also loads; 111 matches the current patch and
     silences the version notice. -->
<modDesc descVersion="111">
    <author>Bones</author>
    <version>0.0.0.3</version>

    <title>
        <en>Husbandry Redux</en>
    </title>
    <description>
        <en><![CDATA[
Husbandry Redux

Deepens Farming Simulator 25's animal husbandry: a herd inspector, buy and sell
scheduling, feed planning and per-barn profit.

Runs on its own. Distribution Redux is optional - install both and Husbandry Redux
adds its pages to the Distribution Redux menu and can plan feed through it. Two
settings need Distribution Redux and say so in the settings screen when it is
not installed; everything else works either way.

Feedback/Issues: https://github.com/Bones50/FS25-Animal-Redux
        ]]></en>
    </description>

    <iconFilename>icon_HusbandryRedux.dds</iconFilename>
    <multiplayer supported="true"/>

    <actions>
        <action name="ANIMALREDUX_OPEN_MANAGER" category="BASE"/>
    </actions>
    <inputBinding>
        <actionBinding action="ANIMALREDUX_OPEN_MANAGER">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_backslash"/>
        </actionBinding>
    </inputBinding>

    <extraSourceFiles>
        <sourceFile filename="scripts/HusbandryRedux.lua"/>
        <!-- EARLY: it owns the savegame file and every other script registers a
             section with it at file scope, so it has to exist by then. -->
        <sourceFile filename="scripts/AnimalPersist.lua"/>
        <sourceFile filename="scripts/AnimalSettings.lua"/>
        <sourceFile filename="scripts/AnimalHelp.lua"/>
        <sourceFile filename="scripts/AnimalPanel.lua"/>
        <sourceFile filename="scripts/AnimalHerdData.lua"/>
        <sourceFile filename="scripts/AnimalFeedModel.lua"/>
        <sourceFile filename="scripts/AnimalEconomics.lua"/>
        <sourceFile filename="scripts/AnimalSellRules.lua"/>
        <sourceFile filename="scripts/AnimalSellExecutor.lua"/>
        <sourceFile filename="scripts/AnimalSellPolicy.lua"/>
        <sourceFile filename="scripts/AnimalTrade.lua"/>
        <!-- AFTER AnimalTrade: it commits through it, and after AnimalPersist,
             whose register() it calls at file scope. -->
        <sourceFile filename="scripts/AnimalBuySchedule.lua"/>
        <!-- AFTER AnimalBuySchedule: it calls that module for the month arithmetic. -->
        <sourceFile filename="scripts/AnimalSellSchedule.lua"/>
        <sourceFile filename="scripts/AnimalHerdPolicy.lua"/>
        <sourceFile filename="scripts/AnimalFeedPolicy.lua"/>
        <sourceFile filename="scripts/AnimalAdvisor.lua"/>
        <sourceFile filename="scripts/AnimalAlerts.lua"/>
        <sourceFile filename="scripts/gui/TextPicker.lua"/>
        <sourceFile filename="scripts/gui/TextTip.lua"/>
        <sourceFile filename="scripts/gui/AnimalTabs.lua"/>
        <sourceFile filename="scripts/gui/AnimalMenuPage.lua"/>
        <sourceFile filename="scripts/gui/AnimalMenu.lua"/>
        <sourceFile filename="scripts/gui/AnimalSettingsPage.lua"/>
        <sourceFile filename="scripts/gui/AnimalHelpPage.lua"/>

        <sourceFile filename="scripts/gui/HerdInspectorPage.lua"/>
        <sourceFile filename="scripts/gui/AnimalTradeDialog.lua"/>
        <sourceFile filename="scripts/gui/AnimalBuyScheduleDialog.lua"/>
        <!-- TEMPORARY dev probe. Remove with the file once the feed model is settled. -->
        <sourceFile filename="scripts/AnimalFoodProbe.lua"/>
    </extraSourceFiles>

    <!-- NO <dependencies> BLOCK, AND THAT IS DELIBERATE.
         This mod declared FS25_Distribution_Redux as a hard dependency until
         2026-09-07. The comment that stood here wondered whether that element
         "hard-blocks loading or merely warns" and said it had not been confirmed
         in game. IT IS NOW: it hard-blocks. With DR removed the game refuses to
         load this mod and prompts the player to reinstall DR, so no amount of
         guarding in code could ever have been reached.
         Husbandry Redux is independently installable as of that date: it carries its
         own GUI profiles, its own husbandry panel renderer, its own menu and page
         base classes, and gates the two settings that genuinely need DR on the
         CAPABILITY being present rather than on DR being installed. The code
         guards (HusbandryRedux.resolveDistributionRedux and friends) remain and are
         now the only mechanism, which is the point.
         DO NOT REINSTATE THIS ELEMENT to express "works better with DR". It does
         not mean that; it means "refuse to run without it". -->

    <l10n filenamePrefix="translations/translation"/>
</modDesc>
