             sale is advised, which is the whole point of the view. -->

        <!-- THE BUY SCHEDULE window: a standing order per barn. The three
             selectors read as the sentence the player is writing, so the labels
             are words and not abbreviations. Column budgets at 12px: WHAT 290px
             (about 48 chars), EVERY 120px, PROGRESS 130px, NEXT 224px. -->
        <text name="ar_bs_title"        text="Vente automatique"/>
        <text name="ar_bs_noBarn"       text="aucune étable"/>
        <text name="ar_bs_colAnimal"    text="ANIMAL"/>
        <text name="ar_bs_colAge"       text="ÂGE"/>
        <text name="ar_bs_colPrice"     text="L'UNITÉ"/>
        <text name="ar_bs_colRow"       text="CATALOGUE"/>
        <text name="ar_bs_colWhat"      text="ORDRE PERMANENT"/>
        <text name="ar_bs_colEvery"     text="TOUS LES"/>
        <text name="ar_bs_colProgress"  text="TERMINÉ"/>
        <text name="ar_bs_colNext"      text="PROCHAIN"/>
        <text name="ar_bs_colNextSale"  text="PROCHAINE VENTE"/>
        <text name="ar_bs_hdrOrder"     text="ORDRE"/>
        <!-- ONE LABEL PER TRANSACTION. Naming the transaction means naming which
             one, so these split the way the "Buy every" / "Sell every" pair does. -->
        <text name="ar_bs_count"        text="Nombre d'animaux par achat :"/>
        <text name="ar_bs_countSell"    text="Nombre d'animaux par vente :"/>
        <!-- THE TEXT PICKER's two grey prompts. The range one takes the cap as a
             parameter and is filled in from the SELECTED BARN's capacity, not from
             a constant, so a 96 animal cow barn says 96. -->
        <text name="ar_bs_numPrompt"    text="Saisir un nombre..."/>
        <text name="ar_bs_numRange"     text="Nombre hors de la plage (%d-%d)..."/>
        <text name="ar_bs_every"        text="Mois entre les achats :"/>
        <text name="ar_bs_for"          text="Nombre d'achats"/>
        <text name="ar_bs_forSell"      text="Nombre de ventes"/>
        <text name="ar_bs_foreverBuy"   text="Acheter indéfiniment :"/>
        <text name="ar_bs_foreverSell"  text="Vendre indéfiniment :"/>
        <!-- WHAT TYPING A RUN COUNT TAKES AWAY, given back as a derived figure in
             the row the Purchases total used to occupy. -->
        <text name="ar_bs_lblSpan"      text="Durée"/>
        <text name="ar_bs_month1"       text="1 mois"/>
        <text name="ar_bs_months"       text="%d mois"/>
        <text name="ar_bs_rowNo"        text="ligne %d"/>
        <text name="ar_bs_lblEach"      text="À chaque fois"/>
        <text name="ar_bs_lblTotal"     text="Engagement total"/>
        <text name="ar_bs_progress"     text="%d / %d"/>
        <text name="ar_bs_paused"       text="en pause"/>
        <text name="ar_bs_done"         text="terminé"/>
        <text name="ar_bs_due"          text="dû maintenant"/>
        <text name="ar_bs_waiting"      text="dans %s"/>
        <text name="ar_bs_btnAdd"       text="Ajouter une commande"/>
        <text name="ar_bs_btnPause"     text="Pause / reprendre"/>
        <text name="ar_bs_btnRemove"    text="Supprimer"/>
        <text name="ar_bs_btnClose"     text="Fermer"/>
        <text name="ar_bs_added"        text="Ajouté : %d x %s, %s"/>
        <text name="ar_bs_removed"      text="Retiré : %d x %s"/>
        <text name="ar_bs_refused"      text="Refusé : %s"/>
        <text name="ar_bs_empty"        text="Le marchand n'offre rien pour cette étable."/>
        <text name="ar_bs_runsAt"       text="S'exécute à %02d:00, ou pendant un sommeil qui franchit cette heure."/>
        <text name="ar_bs_client"       text="Seul l'hôte peut configurer l'achat automatique."/>
        <text name="ar_bs_standDown"    text="L'achat automatique est suspendu pendant que Realistic Livestock est actif."/>
        <text name="ar_hi_btn_schedule" text="Vente automatique"/>

        <!-- THE AUTO TRADER's sell half. Two instruments: a timed ORDER, which is
             a row, and the RULES, which are a per-barn policy the engine already
             runs. The reason and policy names come straight from
             AnimalSellRules, so a code here is a code there. -->
        <text name="ar_bs_modeBuy"      text="ORDRES D'ACHAT"/>
        <text name="ar_bs_modeSell"     text="ORDRES DE VENTE"/>
        <text name="ar_bs_modeRules"    text="RÈGLES DE VENTE"/>
        <text name="ar_bs_hdrRules"     text="RÈGLES"/>
        <!-- THE SELL ORDER LIST IS BY BREED (28.7). A breed is a stable identity a
             player can aim an order at; a cluster is not, and its age and worth
             each describe one slice of a breed rather than the breed. -->
        <!-- WHERE A BREED'S EARNINGS COME FROM, per product. The model prices RAW
             fill types and cannot see what a farm does downstream, so a figure that
             is arithmetically right can still be wrong for this player: manure
             sold is worth a fraction of manure digested. Naming the terms is what
             lets them argue with it. The note line is 1096px over two lines. -->
        <text name="ar_bs_breedTerms"    text="%s : %d têtes, chacune rapportant %s/mois -- %s. Un nouveau-né vaut %s."/>
        <text name="ar_bs_breedNoEarn"   text="%s : %d têtes. Aucune production mensuelle valorisée, une place ici ne rapporte que la valeur de l'animal."/>
        <text name="ar_bs_unpriced"      text="sans prix"/>
        <text name="ar_bs_colBreed"      text="RACE"/>
        <text name="ar_bs_colEarnsAs"    text="PLUS RENTABLE EN"/>
        <text name="ar_bs_colValueTotal" text="VALEUR TOTALE"/>
        <text name="ar_bs_colHead"      text="ANIMAUX"/>
        <text name="ar_bs_colWhatSell"  text="VENTE PERMANENTE"/>
        <text name="ar_bs_everySell"    text="Mois entre les ventes :"/>
        <text name="ar_bs_lblExpected"  text="Total attendu"/>
        <!-- THE PRODUCER VERSUS NURSERY VERDICT, which the engine has computed on
             every plan since the nursery rule shipped and never showed. Diagnostic
             first: it says what the model already concludes about a barn, so the
             player can check it against what they actually keep that barn for.
             The value cell is 118px at 13px, so the two WORDS get about 15
             characters; the sentences sit on a 1096px note line and can breathe. -->
        <text name="ar_bs_lblUse"        text="Plus rentable en tant que"/>
        <text name="ar_bs_useAdult"      text="Producteurs"/>
        <text name="ar_bs_useNursery"    text="Reproducteurs"/>
        <text name="ar_bs_slotAdult"     text="Cette étable rapporte le plus avec le profil PRODUCTEURS : %s/mois, contre %s/mois avec le profil REPRODUCTEURS."/>
        <text name="ar_bs_slotNursery"   text="Cette étable rapporte le plus avec le profil REPRODUCTEURS : %s/mois, contre %s/mois avec le profil PRODUCTEURS."/>
        <!-- NO VERDICT IS ITSELF A FINDING, so it names the term that was missing
             rather than showing a dash. -->
        <text name="ar_bs_slotNone"      text="Aucun verdict PRODUCTEURS / REPRODUCTEURS pour cette étable : %s"/>
        <text name="ar_bs_slotGapEmpty"  text="l'étable ne contient aucun animal à évaluer."/>
        <text name="ar_bs_slotGapMargin" text="ses animaux n'ont aucune production mensuelle valorisée, il n'y a donc rien à comparer avec un nouveau-né."/>
        <text name="ar_bs_slotGapBirth"  text="un nouveau-né de cet animal n'a pas pu être évalué."/>
        <text name="ar_bs_slotGapCycle"  text="cet animal ne déclare aucun cycle de reproduction, le profil REPRODUCTEURS n'a donc pas de taux."/>
        <text name="ar_bs_lblAnimals"   text="Animaux"/>
        <text name="ar_bs_lblNow"       text="Revenu immédiat"/>
        <text name="ar_bs_addedSell"    text="Ajouté : vendre %d, %s. Définissez ses règles dans l'onglet RÈGLES DE VENTE."/>
        <text name="ar_bs_removedSell"  text="Retiré : vente de %d"/>
        <text name="ar_bs_planNothing"  text="Ces règles ne vendraient rien sur cette étable pour l'instant."/>
        <text name="ar_bs_sellRunsAt"   text="Vend dans l'heure une fois l'échéance atteinte - fixez-le le mois avant les naissances pour qu'elles aient de la place."/>

        <!-- the policy switches, one per AnimalSellRules.DEFAULTS key the panel
             exposes. The bijection is asserted by tools/animalsell.lua. -->
        <text name="ar_pol_sellAtPeak"      text="Vendre au pic de valeur"/>
        <text name="ar_pol_keepFreeSlots"   text="Places libres à garder"/>
        <text name="ar_pol_headroomWorthIt" text="Libérer des places seulement si rentable"/>
        <text name="ar_pol_minHealthToSell" text="Ne jamais vendre un troupeau sous"/>
        <text name="ar_pol_keepBreeders"    text="Ne jamais descendre sous (reproducteurs)"/>
        <text name="ar_pol_sellCalves"      text="Vendre les nouveau-nés (profil reproducteur)"/>
        <text name="ar_pol_on"          text="On"/>
        <text name="ar_pol_off"         text="Off"/>
        <text name="ar_pol_noFloor"     text="Aucun plancher"/>
        <text name="ar_pol_pct"         text="%d%% de santé"/>
        <text name="ar_pol_autoSlots"   text="Automatique (naissances à venir)"/>

        <!-- why the plan wants to sell a group. The codes are the engine's own
             REASON_* values, so a new reason there shows as its raw code here
             rather than silently as nothing. -->
        <text name="ar_reason_headroom" text="pour faire de la place aux naissances"/>
        <text name="ar_reason_peak"     text="au pic de valeur"/>
        <text name="ar_reason_calf"     text="nouveau-né (reproducteurs)"/>
        <text name="ar_reason_earnings" text="rapporte moins que ce qu'il perd"/>
        <text name="ar_reason_order"    text="ordre permanent"/>
        <!-- the rule summary carried on each order's row. TRIGGERS only: the
             health and breeder floors never cause a sale, they prevent one, so
             naming them beside these would read as reasons to sell. -->
        <text name="ar_pol_sum_peak"    text="Pic"/>
        <text name="ar_pol_sum_births"  text="Naissances"/>
        <text name="ar_pol_sum_nursery" text="Reproducteurs"/>
        <text name="ar_pol_sum_none"    text="aucune règle"/>
        <text name="ar_bs_colRules"     text="RÈGLES"/>
        <text name="ar_bs_orderTitle"     text="#%d  Vendre %d %s"/>
        <text name="ar_bs_orderTitleBare" text="#%d  Vendre %d"/>
        <text name="ar_bs_titlePaused"    text="%s (en pause)"/>
        <text name="ar_bs_pausedTag"      text="  (en pause)"/>
        <text name="ar_bs_forever"        text="Indéfiniment"/>
        <text name="ar_bs_startIn"        text="Mois avant le début des achats :"/>
        <text name="ar_bs_startInSell"    text="Mois avant le début des ventes :"/>
        <text name="ar_bs_startsIn"       text="démarre dans %s"/>
        <text name="ar_bs_progressOpen"   text="%d en cours"/>
        <text name="ar_bs_ongoing"        text="en cours"/>
        <text name="ar_bs_noOrders"     text="Aucune vente permanente sur cette étable pour l'instant - ajoutez-en une dans l'onglet ORDRES DE VENTE."/>
        <text name="ar_bs_pickOrder"    text="Sélectionner une vente permanente pour définir ses règles."/>

        <!-- ONE SENTENCE PER RULE, shown the moment the player touches it. A
             two-word label cannot carry these and there is nowhere else on the
             dialog to put them. -->
        <text name="ar_pol_help_sellAtPeak"      text="Vendre un animal dès qu'il ne fera plus que perdre de la valeur. Un animal au-delà de son pic produit encore, donc cette règle ne se déclenche que si la baisse dépasse ce qu'il rapporte encore."/>
        <text name="ar_pol_help_keepFreeSlots"   text="Garder ce nombre de places vides pour que les nouveau-nés aient où aller. Une naissance sans place libre est détruite par le jeu. Le mode Automatique calcule le nombre nécessaire au cycle suivant."/>
        <text name="ar_pol_help_headroomWorthIt" text="Ne libérer des places pour les naissances que si l'animal vendu vaut moins que le nouveau-né qui le remplacera. Désactivez cette option pour toujours libérer des places, même à perte."/>
        <text name="ar_pol_help_minHealthToSell" text="Ne jamais vendre tant que la santé moyenne du TROUPEAU est sous ce seuil. Un troupeau malade ne se vend que 40 % de sa valeur comptable, alors que le nourrir d'abord vaut mieux que n'importe quelle vente."/>
        <text name="ar_pol_help_keepBreeders"    text="Ne jamais faire descendre l'étable sous ce nombre d'animaux reproducteurs, pour qu'elle puisse toujours se reconstituer."/>
        <text name="ar_pol_help_sellCalves"      text="Exploiter l'étable avec le profil reproducteur : vendre chaque nouveau-né au lieu de l'élever. Une vente par cycle de reproduction, depuis une place qui n'a jamais à accueillir un animal adulte."/>

        <!-- why a plan came back empty. The engine emits a note kind; the wording
             is ours, because that module is pure. -->
        <text name="ar_note_breeding"   text="Vendus, les animaux valent moins que les nouveau-nés qu'ils produiraient - désactivez Ne libérer de la place que si la vente est rentable."/>
        <text name="ar_note_blocked"    text="Le minimum de reproducteurs bloque la vente - baissez Ne jamais descendre sous (reproducteurs)."/>
        <text name="ar_note_held"       text="Le troupeau est sous le plancher de santé - nourrissez-le, ou baissez « Ne jamais vendre un troupeau sous »."/>
        <text name="ar_note_unsellable" text="Rien ici ne peut être vendu pour le moment."/>
        <text name="ar_note_nursery"    text="Cette étable rapporterait plus avec le profil reproducteur - activez « Vendre les nouveau-nés »."/>

        <!-- SETTINGS, shown as an HUSBANDRY REDUX tab on Distribution Redux's own
             Settings page. Titles sit in a fixed width column and the tooltip is
             the only place with room to explain, so the title stays short and the
             tooltip carries the consequence.
             CHARACTER BUDGET: title around 34, tooltip wraps and is not clipped.
             The tab caption is UPPERCASE to match DR's own tab beside it. -->
        <!-- THE USER GUIDE TAB. The body is one long line per paragraph on purpose:
             the page word-wraps to its own column count, so a hand-wrapped paragraph
             renders ragged. "## " starts a sub-heading. -->
        <text name="ar_help_tab"           text="HUSBANDRY REDUX"/>
        <text name="ar_overview_tab"       text="HUSBANDRY REDUX"/>
        <text name="ar_legacy_warning" text="%s a été renommé en Husbandry Redux.&#10;&#10;L'ancien mod (%s) est toujours installé et les deux sont actifs, tout apparaîtra donc en double.&#10;&#10;Revenez au menu principal, supprimez ce mod de votre dossier mods, puis rechargez. Vos données animales sont conservées."/>
        <text name="ar_overview_placeholder" text="En construction"/>

        <text name="ar_set_tab"            text="HUSBANDRY REDUX"/>
        <text name="ar_set_off"            text="Off"/>
        <text name="ar_set_on"             text="On"/>

        <text name="ar_set_trading"        text="Acheter / vendre des animaux"/>
        <text name="ar_set_trading_tt"     text="Acheter et vendre manuellement des animaux depuis l’Inspecteur du troupeau. La désactivation retire le bouton Acheter / vendre. Les ordres permanents ne sont pas affectés : désactivez la vente automatique pour les arrêter."/>

        <text name="ar_set_autoTrader"     text="Vente automatique"/>
        <text name="ar_set_autoTrader_tt"  text="Ordres permanents d’achat et de vente exécutés automatiquement. La désactivation retire le bouton Vente automatique ainsi que les boutons Règles de vente et Règles d’achat, et SUPPRIME tous les ordres créés. Une confirmation vous sera demandée."/>

        <text name="ar_set_herdAdviser"       text="Conseiller du troupeau"/>
        <text name="ar_set_herdAdviser_tt"    text="Suggestions de Husbandry Redux : les deux lignes de conseil sur le panneau de l’étable et la colonne RECOMMANDATION de l’onglet Animaux. La désactivation masque ces suggestions, mais toutes les données utilisées pour les établir restent affichées."/>

        <text name="ar_set_advancedFeeder"    text="Alimentation avancée des animaux"/>
        <text name="ar_set_advancedFeeder_tt" text="Husbandry Redux détermine de quel aliment chaque étable a réellement besoin et demande à Distribution Redux de le fournir. Chaque étable peut être activée ou désactivée dans l’onglet Porcs. Lorsque cette option est désactivée, chaque étable revient aux règles d’approvisionnement de Distribution Redux. Cette option n’a aucun effet tant que l’alimentation des animaux de Distribution Redux est désactivée : rien n’est alors distribué automatiquement."/>
        <text name="ar_hi_feed_on"            text="Alimentation avancée : On"/>
        <text name="ar_hi_feed_off"           text="Alimentation avancée : Off"/>
        <text name="ar_hi_feed_drOff"         text="L'alimentation des animaux par DR est désactivée - rien n'est distribué automatiquement"/>

        <text name="ar_set_debug"          text="Journalisation du débogage"/>
        <text name="ar_set_debug_tt"       text="Ajoute des lignes Husbandry Redux dans log.txt. Laissez cette option désactivée sauf si vous signalez un problème. Les erreurs réelles sont enregistrées dans tous les cas."/>
        <text name="ar_set_passProfiler"    text="Journalisation des performances"/>
        <text name="ar_set_passProfiler_tt" text="Enregistre dans log.txt la durée de la passe horaire de Distribution Redux ainsi que le nombre de scans du monde effectués. Laissez sur Passes lentes uniquement : rien n’est enregistré sauf si une passe horaire dépasse 150 ms. Passez à Toutes les passes si un rapport de performances vous est demandé : deux lignes sont alors enregistrées à chaque heure de jeu afin de comparer une ferme normale à une ferme ralentie. Il s’agit du même réglage que sur la page de Distribution Redux ; l’activer à l’un ou l’autre endroit suffit."/>
        <text name="ar_set_prof_off"        text="Off"/>
        <text name="ar_set_prof_slow"       text="Passages lents uniquement"/>
        <text name="ar_set_prof_all"        text="Tous les passages (diagnostic)"/>
        <text name="ar_set_needsDR"         text="(nécessite Distribution Redux)"/>
        <text name="ar_unit_litre"          text=" L"/>
        <text name="ar_unit_kilolitre"      text=" kL"/>
        <text name="ar_set_needsDR_tt"      text="Ce paramètre nécessite Distribution Redux, qui n’est pas installé ou dont la version est trop ancienne pour cette fonctionnalité. Husbandry Redux fonctionne sans lui, mais cette option reste indisponible. Votre choix est conservé et s’appliquera dès que Distribution Redux sera disponible."/>

        <!-- The confirmation raised when the Auto Trader is switched off. It NAMES
             the counts, because "this will delete things" is not a question a
             player can answer. -->
        <text name="ar_set_clearTitle"     text="Désactiver la vente automatique ?"/>
        <text name="ar_set_clearText"      text="Cette action supprime %d plan(s) d’achat et %d ordre(s) de vente. Cette action est irréversible."/>


    </texts>
</l10n>
