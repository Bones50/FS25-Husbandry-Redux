        <text name="ar_bs_colBreed"      text="品种"/>
        <text name="ar_bs_colEarnsAs"    text="收益最高的用途"/>
        <text name="ar_bs_colValueTotal" text="总价值"/>
        <text name="ar_bs_colHead"      text="存栏数"/>
