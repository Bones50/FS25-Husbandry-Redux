        <text name="ar_bs_lblSpan"      text="Runs over"/>
        <text name="ar_bs_month1"       text="1 month"/>
        <text name="ar_bs_months"       text="%d months"/>
        <text name="ar_bs_rowNo"        text="row %d"/>
        <text name="ar_bs_lblEach"      text="Each time"/>
        <text name="ar_bs_lblTotal"     text="Total commitment"/>
        <text name="ar_bs_progress"     text="%d / %d"/>
        <text name="ar_bs_paused"       text="paused"/>
        <text name="ar_bs_done"         text="done"/>
        <text name="ar_bs_due"          text="due now"/>
        <text name="ar_bs_waiting"      text="in %s"/>
        <text name="ar_bs_btnAdd"       text="Add order"/>
        <text name="ar_bs_btnPause"     text="Pause / resume"/>
        <text name="ar_bs_btnRemove"    text="Remove"/>
        <text name="ar_bs_btnClose"     text="Close"/>
        <text name="ar_bs_added"        text="Added: %d x %s, %s"/>
        <text name="ar_bs_removed"      text="Removed: %d x %s"/>
        <text name="ar_bs_refused"      text="Refused: %s"/>
        <text name="ar_bs_empty"        text="The dealer is offering nothing for this barn."/>
