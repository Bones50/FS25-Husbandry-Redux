        <text name="ar_bs_client"       text="Only the host can set up automatic buying."/>
        <text name="ar_bs_standDown"    text="Automatic buying stands down while Realistic Livestock is running."/>
        <text name="ar_hi_btn_schedule" text="Auto Trader"/>

        <!-- THE AUTO TRADER's sell half. Two instruments: a timed ORDER, which is
             a row, and the RULES, which are a per-barn policy the engine already
             runs. The reason and policy names come straight from
             AnimalSellRules, so a code here is a code there. -->
        <text name="ar_bs_modeBuy"      text="BUY ORDERS"/>
        <text name="ar_bs_modeSell"     text="SELL ORDERS"/>
        <text name="ar_bs_modeRules"    text="SELL RULES"/>
        <text name="ar_bs_hdrRules"     text="THE RULES"/>
        <!-- THE SELL ORDER LIST IS BY BREED (28.7). A breed is a stable identity a
             player can aim an order at; a cluster is not, and its age and worth
             each describe one slice of a breed rather than the breed. -->
        <!-- WHERE A BREED'S EARNINGS COME FROM, per product. The model prices RAW
             fill types and cannot see what a farm does downstream, so a figure that
             is arithmetically right can still be wrong for this player: manure
             sold is worth a fraction of manure digested. Naming the terms is what
             lets them argue with it. The note line is 1096px over two lines. -->
        <text name="ar_bs_breedTerms"    text="%s: %d head, each earning %s/mo -- %s. A calf is worth %s."/>
        <text name="ar_bs_breedNoEarn"   text="%s: %d head. No priced monthly output, so a slot here earns only what the animal is worth."/>
        <text name="ar_bs_unpriced"      text="not priced"/>
        <text name="ar_bs_colBreed"      text="BREED"/>
        <text name="ar_bs_colEarnsAs"    text="EARNS MOST AS"/>
        <text name="ar_bs_colValueTotal" text="TOTAL VALUE"/>
        <text name="ar_bs_colHead"      text="ANIMALS"/>
        <text name="ar_bs_colWhatSell"  text="STANDING SALE"/>
        <text name="ar_bs_everySell"    text="Months between sales:"/>
        <text name="ar_bs_lblExpected"  text="Total expected"/>
        <!-- THE PRODUCER VERSUS NURSERY VERDICT, which the engine has computed on
             every plan since the nursery rule shipped and never showed. Diagnostic
             first: it says what the model already concludes about a barn, so the
             player can check it against what they actually keep that barn for.
             The value cell is 118px at 13px, so the two WORDS get about 15
             characters; the sentences sit on a 1096px note line and can breathe. -->
        <text name="ar_bs_lblUse"        text="Earns most as"/>
        <text name="ar_bs_useAdult"      text="Producers"/>
        <text name="ar_bs_useNursery"    text="Nursery"/>
        <text name="ar_bs_slotAdult"     text="This barn earns most from PRODUCERS: %s/mo, against %s/mo run as a nursery."/>
        <text name="ar_bs_slotNursery"   text="This barn earns most as a NURSERY: %s/mo, against %s/mo from producers."/>
        <!-- NO VERDICT IS ITSELF A FINDING, so it names the term that was missing
             rather than showing a dash. -->
        <text name="ar_bs_slotNone"      text="No producer / nursery verdict for this barn: %s"/>
        <text name="ar_bs_slotGapEmpty"  text="the barn holds no animals to judge."/>
        <text name="ar_bs_slotGapMargin" text="its animals have no priced monthly output, so there is nothing to weigh a calf against."/>
        <text name="ar_bs_slotGapBirth"  text="a newborn of this animal could not be priced."/>
        <text name="ar_bs_slotGapCycle"  text="this animal declares no breeding cycle, so a nursery has no rate."/>
        <text name="ar_bs_lblAnimals"   text="Animals"/>
        <text name="ar_bs_lblNow"       text="Revenue now"/>
        <text name="ar_bs_addedSell"    text="Added: sell %d, %s. Set its rules on the SELL RULES tab."/>
        <text name="ar_bs_removedSell"  text="Removed: sell %d"/>
        <text name="ar_bs_planNothing"  text="These rules would sell nothing on this barn right now."/>
        <text name="ar_bs_sellRunsAt"   text="Sells within the hour once due - set it for the month before births so they have room."/>

        <!-- the policy switches, one per AnimalSellRules.DEFAULTS key the panel
             exposes. The bijection is asserted by tools/animalsell.lua. -->
        <text name="ar_pol_sellAtPeak"      text="Sell at peak value"/>
        <text name="ar_pol_keepFreeSlots"   text="Free slots to keep"/>
        <text name="ar_pol_headroomWorthIt" text="Only make room if it pays"/>
        <text name="ar_pol_minHealthToSell" text="Never sell a herd below"/>
        <text name="ar_pol_keepBreeders"    text="Never go below (breeders)"/>
        <text name="ar_pol_sellCalves"      text="Sell newborns (nursery)"/>
        <text name="ar_pol_on"          text="On"/>
        <text name="ar_pol_off"         text="Off"/>
        <text name="ar_pol_noFloor"     text="No floor"/>
        <text name="ar_pol_pct"         text="%d%% health"/>
        <text name="ar_pol_autoSlots"   text="Automatic (next births)"/>

        <!-- why the plan wants to sell a group. The codes are the engine's own
             REASON_* values, so a new reason there shows as its raw code here
             rather than silently as nothing. -->
        <text name="ar_reason_headroom" text="to make room for births"/>
        <text name="ar_reason_peak"     text="at peak value"/>
        <text name="ar_reason_calf"     text="newborn (nursery)"/>
        <text name="ar_reason_earnings" text="earning less than it loses"/>
        <text name="ar_reason_order"    text="standing order"/>
        <!-- the rule summary carried on each order's row. TRIGGERS only: the
             health and breeder floors never cause a sale, they prevent one, so
             naming them beside these would read as reasons to sell. -->
        <text name="ar_pol_sum_peak"    text="Peak"/>
        <text name="ar_pol_sum_births"  text="Births"/>
        <text name="ar_pol_sum_nursery" text="Nursery"/>
        <text name="ar_pol_sum_none"    text="no rules"/>
        <text name="ar_bs_colRules"     text="RULES"/>
        <text name="ar_bs_orderTitle"     text="#%d  Sell %d %s"/>
        <text name="ar_bs_orderTitleBare" text="#%d  Sell %d"/>
        <text name="ar_bs_titlePaused"    text="%s  (paused)"/>
        <text name="ar_bs_pausedTag"      text="  (paused)"/>
        <text name="ar_bs_forever"        text="Forever"/>
        <text name="ar_bs_startIn"        text="Months before buying starts:"/>
        <text name="ar_bs_startInSell"    text="Months before selling starts:"/>
        <text name="ar_bs_startsIn"       text="starts in %s"/>
        <text name="ar_bs_progressOpen"   text="%d  ongoing"/>
        <text name="ar_bs_ongoing"        text="ongoing"/>
        <text name="ar_bs_noOrders"     text="No standing sales on this barn yet - add one on the SELL ORDERS tab."/>
        <text name="ar_bs_pickOrder"    text="Select a standing sale to set its rules."/>

        <!-- ONE SENTENCE PER RULE, shown the moment the player touches it. A
             two-word label cannot carry these and there is nowhere else on the
             dialog to put them. -->
        <text name="ar_pol_help_sellAtPeak"      text="Sell an animal once it will only lose value from here. A cow past its peak still produces, so this only fires when the decline beats what it still earns."/>
        <text name="ar_pol_help_keepFreeSlots"   text="Keep this many pen slots empty so newborns have somewhere to go. A birth with no free slot is destroyed by the game. Automatic works out how many the next cycle needs."/>
        <text name="ar_pol_help_headroomWorthIt" text="Only make room for births when the animal sold is worth less than the calf it would raise. Turn this off to always make room, even at a loss."/>
        <text name="ar_pol_help_minHealthToSell" text="Never sell while the HERD average health is below this. A sick herd fetches as little as 40% of book value, so feeding it first is worth more than any sale."/>
        <text name="ar_pol_help_keepBreeders"    text="Never take the barn below this many breeding animals, so it can always restock itself."/>
        <text name="ar_pol_help_sellCalves"      text="Run the barn as a nursery: sell every newborn instead of raising it. One sale per breeding cycle, from a slot that never has to hold a grown animal."/>

        <!-- why a plan came back empty. The engine emits a note kind; the wording
             is ours, because that module is pure. -->
        <text name="ar_note_breeding"   text="The animals are worth less sold than the calves they would raise - switch off Only make room if it pays to sell anyway."/>
        <text name="ar_note_blocked"    text="The breeder floor is stopping it - lower Never go below (breeders)."/>
        <text name="ar_note_held"       text="The herd is below the health floor - feed it, or lower Never sell a herd below."/>
        <text name="ar_note_unsellable" text="Nothing here can be sold at the moment."/>
        <text name="ar_note_nursery"    text="This barn would earn more run as a nursery - switch on Sell newborns."/>

        <!-- SETTINGS, shown as an HUSBANDRY REDUX tab on Distribution Redux's own
             Settings page. Titles sit in a fixed width column and the tooltip is
             the only place with room to explain, so the title stays short and the
             tooltip carries the consequence.
             CHARACTER BUDGET: title around 34, tooltip wraps and is not clipped.
             The tab caption is UPPERCASE to match DR's own tab beside it. -->
        <!-- THE USER GUIDE TAB. The body is one long line per paragraph on purpose:
             the page word-wraps to its own column count, so a hand-wrapped paragraph
             renders ragged. "## " starts a sub-heading. -->
        <text name="ar_help_tab"           text="HUSBANDRY REDUX"/>
        <text name="ar_overview_tab"       text="HUSBANDRY REDUX"/>
        <text name="ar_legacy_warning" text="%s has been renamed to Husbandry Redux.&#10;&#10;The old mod (%s) is still installed and both are running, so everything will appear twice.&#10;&#10;Quit to the main menu, delete that mod from your mods folder, and load again. Your animal data is kept."/>
        <text name="ar_overview_placeholder" text="Under Construction"/>

        <text name="ar_set_tab"            text="HUSBANDRY REDUX"/>
        <text name="ar_set_off"            text="Off"/>
        <text name="ar_set_on"             text="On"/>

        <text name="ar_set_trading"        text="Buy / Sell animals"/>
        <text name="ar_set_trading_tt"     text="Buying and selling animals by hand from the Herd Inspector. Off removes the Buy / Sell button. Standing orders are unaffected - switch the Auto Trader off for those."/>

        <text name="ar_set_autoTrader"     text="Auto Trader"/>
        <text name="ar_set_autoTrader_tt"  text="Standing buy and sell orders that run on their own. Off removes the Auto Trader button and the Sell Rules and Buy Rules buttons, AND DELETES every order you have set up. You will be asked to confirm first."/>

        <text name="ar_set_herdAdviser"       text="Herd Adviser"/>
        <text name="ar_set_herdAdviser_tt"    text="Husbandry Redux's suggestions: the two advice lines on the barn panel and the RECOMMENDATION column on the Animals tab. Off hides them. Every figure they were drawn from stays on screen."/>

        <text name="ar_set_advancedFeeder"    text="Advanced animal feeder"/>
        <text name="ar_set_advancedFeeder_tt" text="Husbandry Redux works out which feed each barn actually needs and asks Distribution Redux for that, and each barn can be switched on or off on the Pigs tab. Off hands every barn back to Distribution Redux's own supply rules. Has no effect while Distribution Redux's husbandry feeding is switched off - then nothing is fed automatically."/>
        <text name="ar_hi_feed_on"            text="Advanced feeding: On"/>
        <text name="ar_hi_feed_off"           text="Advanced feeding: Off"/>
        <text name="ar_hi_feed_drOff"         text="DR husbandry feeding is off - nothing is fed automatically"/>

        <text name="ar_set_debug"          text="Debug logging"/>
        <text name="ar_set_debug_tt"       text="Extra Husbandry Redux lines in log.txt. Leave this off unless you are reporting a problem. Anything that actually goes wrong is logged either way."/>
        <text name="ar_set_passProfiler"    text="Performance logging"/>
        <text name="ar_set_passProfiler_tt" text="Writes what Distribution Redux's hourly pass cost to log.txt, and how many world scans it made. Leave on Slow passes only - it is silent unless an hourly pass takes longer than 150ms. Switch to Every pass if you are asked for a performance report: it then logs two lines every in-game hour, which is what lets a healthy farm be compared against a slow one. This is the same setting as the one on Distribution Redux's own page, and either one being on enables it."/>
        <text name="ar_set_prof_off"        text="Off"/>
        <text name="ar_set_prof_slow"       text="Slow passes only"/>
        <text name="ar_set_prof_all"        text="Every pass (diagnostic)"/>
        <text name="ar_set_needsDR"         text="(needs Distribution Redux)"/>
        <text name="ar_unit_litre"          text=" L"/>
        <text name="ar_unit_kilolitre"      text=" kL"/>
        <text name="ar_set_needsDR_tt"      text="This setting needs Distribution Redux, which is not installed (or is an older version without the feature). Husbandry Redux works without it - only this option is unavailable. Your choice has been kept and will apply again as soon as Distribution Redux is present."/>

        <!-- The confirmation raised when the Auto Trader is switched off. It NAMES
             the counts, because "this will delete things" is not a question a
             player can answer. -->
        <text name="ar_set_clearTitle"     text="Turn the Auto Trader off?"/>
        <text name="ar_set_clearText"      text="This deletes %d buy schedule(s) and %d sell order(s). There is no undo."/>


    </texts>
